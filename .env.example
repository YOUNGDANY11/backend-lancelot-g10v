URL_DB = postgresql://user:password@host:port/database
JWT_SECRET = replace-with-a-strong-secret
JWT_EXPIRES = 15m
JWT_REFRESH_EXPIRES_DAYS = 30
# Comma-separated list of allowed origins for the frontend client (e.g. http://localhost:5173)
CORS_ORIGIN = http://localhost:5173
# Sal secreta para seudonimizar id_user (HMAC-SHA256) en GET /api/ml/features/export.
# Mantenerla fija: si cambia, las claves de los deportistas en los CSV cambian.
ML_EXPORT_SALT = replace-with-a-long-random-secret
