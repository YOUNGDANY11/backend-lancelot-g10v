URL_DB = postgresql://user:password@host:port/database
JWT_SECRET = replace-with-a-strong-secret
JWT_EXPIRES = 15m
JWT_REFRESH_EXPIRES_DAYS = 30
# Comma-separated list of allowed origins for the frontend client (e.g. http://localhost:5173)
CORS_ORIGIN = http://localhost:5173
ML_EXPORT_SALT = replace-with-a-long-random-secret
ML_SERVICE_URL = http://localhost:8000
ML_SERVICE_API_KEY = replace-with-a-long-random-secret
ML_SERVICE_TIMEOUT_MS = 5000
